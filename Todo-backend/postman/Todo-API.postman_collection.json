{
    "info": {
        "name": "Todo API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Health",
            "request": {
                "method": "GET",
                "url": "http://localhost:3000/health"
            }
        },
        {
            "name": "List todos",
            "request": {
                "method": "GET",
                "url": "http://localhost:3000/api/todos"
            }
        },
        {
            "name": "List overdue",
            "request": {
                "method": "GET",
                "url": "http://localhost:3000/api/todos?overdue=true"
            }
        },
        {
            "name": "List doing",
            "request": {
                "method": "GET",
                "url": "http://localhost:3000/api/todos?status=doing"
            }
        },
        {
            "name": "Create todo (full)",
            "request": {
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "method": "POST",
                "url": "http://localhost:3000/api/todos",
                "body": {
                    "mode": "raw",
                    "raw": "{\"title\": \"ส่งรายงาน\", \"category\": \"งาน\", \"due_date\": \"2026-09-30T17:00:00+07:00\", \"status\": \"todo\"}"
                }
            }
        },
        {
            "name": "Get one todo",
            "request": {
                "method": "GET",
                "url": "http://localhost:3000/api/todos/1"
            }
        },
        {
            "name": "Update todo (PUT)",
            "request": {
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "method": "PUT",
                "url": "http://localhost:3000/api/todos/1",
                "body": {
                    "mode": "raw",
                    "raw": "{\"title\": \"ส่งรายงาน (แก้)\", \"category\": \"งาน\", \"due_date\": \"2026-09-30T17:00:00+07:00\", \"status\": \"doing\"}"
                }
            }
        },
        {
            "name": "Set status doing/done",
            "request": {
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "method": "PATCH",
                "url": "http://localhost:3000/api/todos/1/status",
                "body": {
                    "mode": "raw",
                    "raw": "{\"status\": \"doing\"}"
                }
            }
        },
        {
            "name": "Toggle todo",
            "request": {
                "method": "PATCH",
                "url": "http://localhost:3000/api/todos/1/toggle"
            }
        },
        {
            "name": "Delete todo",
            "request": {
                "method": "DELETE",
                "url": "http://localhost:3000/api/todos/1"
            }
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000"
        }
    ]
}